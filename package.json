{
  "name": "gameroute",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "version": "0.1.20",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gameroute/desktop dev",
    "dev:web": "pnpm --filter @gameroute/web dev",
    "build": "pnpm -r build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @gameroute/db db:generate",
    "db:migrate": "pnpm --filter @gameroute/db db:migrate",
    "tauri": "pnpm --filter @gameroute/desktop tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
