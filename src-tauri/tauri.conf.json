{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GameRoute",
  "identifier": "app.gameroute.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "GameRoute",
        "width": 1400,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://*.steamstatic.com https://*.epicgames.com data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREOTU3NDFERDU0RDdDM0QKUldROWZFM1ZIWFNWM2RIK2x3dHNjWnZKcEtzSTBxQ3pxNHNZTzBFU1RlTDJjMUNUOXgwZFliY3IK",
      "endpoints": ["https://github.com/bruno00o/gameroute/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/gameroute-capture-service"],
    "resources": [
      "resources/GeoLite2-City.mmdb",
      "resources/GeoLite2-ASN.mmdb"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsi"
      }
    }
  }
}
